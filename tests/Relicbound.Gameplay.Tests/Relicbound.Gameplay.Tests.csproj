<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for Relicbound.Gameplay — combat resolution, artifact triggers,
    rune composition, expedition generation.

    Per docs/CODING_STANDARDS.md these are the highest-priority tests in the
    project, because they cover the systems that define whether the game is
    fun: damage calculation, effects, triggers, and status interactions.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Relicbound.Gameplay.Tests</RootNamespace>
    <AssemblyName>Relicbound.Gameplay.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Relicbound.Core/Relicbound.Core.csproj" />
    <ProjectReference Include="../../src/Relicbound.Gameplay/Relicbound.Gameplay.csproj" />
    <ProjectReference Include="../../src/Relicbound.Content/Relicbound.Content.csproj" />
  </ItemGroup>

</Project>
